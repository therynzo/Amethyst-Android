<?xml version="1.0" encoding="utf-8"?>
<!-- Nick Launcher main menu (landscape). Same view IDs/classes as upstream so the code is untouched. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ImageView
        android:id="@+id/nick_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/nick_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- dark scrim: the pixel background was too bright -->
    <View
        android:id="@+id/nick_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A6070709"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/nick_split"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.62" />

    <!-- 3D skin of the selected account, with name tag on top -->
    <com.kdt.mcgui.NickSkinView
        android:id="@+id/nick_skin_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        app:layout_constraintBottom_toTopOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toStartOf="@id/nick_split"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- light-black layer only behind the version bar -->
    <View
        android:id="@+id/nick_version_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/nick_panel_bg"
        app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toEndOf="@id/play_button"
        app:layout_constraintStart_toStartOf="@id/mc_version_spinner"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

    <!-- Version picker + edit + big green PLAY button -->
    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@android:color/transparent"
        android:drawableEnd="@drawable/spinner_arrow"
        android:paddingStart="@dimen/_4sdp"
        android:paddingEnd="@dimen/_8sdp"
        app:drawableEndPadding="@dimen/_1sdp"
        app:drawableEndSize="@dimen/_12sdp"
        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="@dimen/_30sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/edit_profile_button"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_4sdp"
        android:background="?android:attr/selectableItemBackground"
        android:src="@drawable/ic_edit_profile"
        app:layout_constraintBottom_toBottomOf="@+id/mc_version_spinner"
        app:layout_constraintEnd_toStartOf="@+id/play_button"
        app:layout_constraintStart_toEndOf="@id/mc_version_spinner"
        app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/_4sdp"
        android:minWidth="@dimen/_100sdp"
        android:text="@string/main_play"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="@+id/mc_version_spinner"
        app:layout_constraintEnd_toStartOf="@id/nick_split"
        app:layout_constraintStart_toEndOf="@id/edit_profile_button"
        app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />

    <!-- light-black layer behind all menu buttons -->
    <View
        android:id="@+id/nick_menu_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/nick_panel_bg"
        app:layout_constraintBottom_toBottomOf="@id/nick_menu_scroll"
        app:layout_constraintEnd_toEndOf="@id/nick_menu_scroll"
        app:layout_constraintStart_toStartOf="@id/nick_menu_scroll"
        app:layout_constraintTop_toTopOf="@id/nick_menu_scroll" />

    <!-- Menu cards on the right -->
    <ScrollView
        android:id="@+id/nick_menu_scroll"
        android:padding="@dimen/_6sdp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/nick_split"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/nick_card_bg"
                android:drawableStart="@drawable/nick_ic_grid"
                android:text="Mod Browser" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/nick_card_bg"
                android:drawableStart="@drawable/nick_ic_gamepad"
                android:text="@string/mcl_option_customcontrol" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/nick_card_bg"
                android:drawableStart="@drawable/nick_ic_extension"
                android:text="@string/main_install_jar_file" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/nick_card_bg"
                android:drawableStart="@drawable/nick_ic_description"
                android:text="@string/main_share_logs" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:background="@drawable/nick_card_bg"
                android:drawableStart="@drawable/nick_ic_folder"
                android:text="@string/mcl_button_open_directory" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
