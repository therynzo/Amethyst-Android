<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- shared background so the translucent top bar has something to show through -->
    <ImageView
        android:id="@+id/nick_window_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/nick_bg" />

    <View
        android:id="@+id/nick_topbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:background="@drawable/nick_topbar_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/nick_logo"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pojav_full"
        app:layout_constraintBottom_toBottomOf="@id/nick_topbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/nick_topbar" />

    <TextView
        android:id="@+id/nick_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:text="Nick Launcher"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/nick_topbar"
        app:layout_constraintStart_toEndOf="@id/nick_logo"
        app:layout_constraintTop_toTopOf="@id/nick_topbar" />

    <com.kdt.mcgui.mcAccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:background="@drawable/nick_account_bg"
        android:popupBackground="@drawable/nick_account_bg"
        android:dropDownWidth="@dimen/_150sdp"
        android:dropDownVerticalOffset="@dimen/_34sdp"
        app:layout_constraintBottom_toBottomOf="@id/nick_topbar"
        app:layout_constraintEnd_toStartOf="@id/setting_button"
        app:layout_constraintTop_toTopOf="@id/nick_topbar" />

    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/nick_icon_btn_bg"
        android:contentDescription="Settings"
        android:padding="@dimen/_7sdp"
        android:scaleType="fitCenter"
        android:src="@drawable/nick_ic_settings"
        app:layout_constraintBottom_toBottomOf="@id/nick_topbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/nick_topbar" />

    <!-- Holding most of the dynamic content -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"

        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout"
        app:layout_constraintTop_toBottomOf="@id/nick_topbar" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
