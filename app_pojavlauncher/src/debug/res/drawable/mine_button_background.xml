<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- pressed: sinks down, bottom edge shrinks -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="4dp" android:right="4dp"><shape><solid android:color="#3F8F37" /></shape></item>
            <item android:left="4dp" android:right="4dp" android:top="4dp" android:bottom="2dp"><shape><solid android:color="#4FB043" /></shape></item>
            <item android:gravity="start" android:top="6dp" android:bottom="2dp"><shape><size android:width="4dp" /><solid android:color="#4FB043" /></shape></item>
            <item android:gravity="end" android:top="6dp" android:bottom="2dp"><shape><size android:width="4dp" /><solid android:color="#4FB043" /></shape></item>
        </layer-list>
    </item>

    <!-- disabled -->
    <item android:state_enabled="false">
        <layer-list>
            <item android:left="4dp" android:right="4dp"><shape><solid android:color="#2A2A32" /></shape></item>
            <item android:left="4dp" android:right="4dp" android:bottom="4dp"><shape><solid android:color="#3A3A44" /></shape></item>
            <item android:gravity="start" android:top="4dp" android:bottom="4dp"><shape><size android:width="4dp" /><solid android:color="#3A3A44" /></shape></item>
            <item android:gravity="end" android:top="4dp" android:bottom="4dp"><shape><size android:width="4dp" /><solid android:color="#3A3A44" /></shape></item>
        </layer-list>
    </item>

    <!-- normal -->
    <item>
        <layer-list>
            <!-- dark base = bottom edge -->
            <item android:left="4dp" android:right="4dp"><shape><solid android:color="#3F8F37" /></shape></item>
            <!-- light top edge -->
            <item android:left="4dp" android:right="4dp" android:bottom="6dp"><shape><solid android:color="#8EE07F" /></shape></item>
            <!-- main green body -->
            <item android:left="4dp" android:right="4dp" android:top="3dp" android:bottom="6dp"><shape><solid android:color="#5EC84F" /></shape></item>
            <!-- side wings (shorter than the body, with their own dark foot) -->
            <item android:gravity="start" android:top="5dp" android:bottom="3dp"><shape><size android:width="4dp" /><solid android:color="#3F8F37" /></shape></item>
            <item android:gravity="end" android:top="5dp" android:bottom="3dp"><shape><size android:width="4dp" /><solid android:color="#3F8F37" /></shape></item>
            <item android:gravity="start" android:top="5dp" android:bottom="6dp"><shape><size android:width="4dp" /><solid android:color="#5EC84F" /></shape></item>
            <item android:gravity="end" android:top="5dp" android:bottom="6dp"><shape><size android:width="4dp" /><solid android:color="#5EC84F" /></shape></item>
        </layer-list>
    </item>
</selector>
