<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- pressed: button sinks down, bottom edge shrinks -->
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#2F7A28" /></shape></item>
            <item android:top="3dp" android:bottom="2dp"><shape android:shape="rectangle"><solid android:color="#3A9330" /></shape></item>
        </layer-list>
    </item>
    <!-- disabled: flat gray-green -->
    <item android:state_enabled="false">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#2A2A32" /></shape></item>
            <item android:bottom="3dp"><shape android:shape="rectangle"><solid android:color="#3A3A44" /></shape></item>
        </layer-list>
    </item>
    <!-- normal -->
    <item>
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#2F7A28" /></shape></item>
            <item android:bottom="5dp"><shape android:shape="rectangle"><solid android:color="#7BDB6C" /></shape></item>
            <item android:top="3dp" android:bottom="5dp"><shape android:shape="rectangle"><solid android:color="#43A838" /></shape></item>
        </layer-list>
    </item>
</selector>
