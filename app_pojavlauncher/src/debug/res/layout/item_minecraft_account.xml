<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="@dimen/_32sdp"
    android:layout_width="match_parent"
    android:orientation="horizontal">

    <fr.spse.extended_view.ExtendedTextView
        android:id="@+id/account_item"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:textSize="@dimen/_12ssp"
        android:gravity="center_vertical"
        android:drawablePadding="@dimen/_6sdp"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_4sdp"
        app:drawableEndSize="@dimen/_20sdp"
        tools:text="Steve"
        tools:ignore="RtlSymmetry" />

    <!-- keep an ImageView here: the spinner needs the extended view to receive the click -->
    <ImageView
        android:id="@+id/delete_account_button"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:src="@drawable/ic_menu_delete_forever"
        android:padding="@dimen/_8sdp" />
</LinearLayout>
