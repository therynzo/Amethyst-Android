<?xml version="1.0" encoding="utf-8"?>
<!-- Nick Launcher: version / profile editor (same view IDs and types as upstream) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fadeScrollbars="true" android:scrollbarThumbVertical="@color/minebutton_color">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="@dimen/_10sdp" android:paddingVertical="@dimen/_6sdp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="@dimen/_6sdp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PROFILE" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <View android:layout_width="@dimen/_30sdp" android:layout_height="2dp"
                android:layout_marginTop="3dp" android:background="#5EC84F" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" android:gravity="center_vertical" android:orientation="horizontal"
                android:background="@drawable/nick_card_bg" android:padding="@dimen/_8sdp">
                <FrameLayout android:layout_width="@dimen/_50sdp" android:layout_height="@dimen/_50sdp">
                    <ImageView android:id="@+id/vprof_editor_profile_icon" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:paddingHorizontal="@dimen/profile_editor_image_padding" android:paddingVertical="@dimen/profile_editor_image_padding" />
                    <ImageView android:layout_width="@dimen/_14sdp" android:layout_height="@dimen/_14sdp" android:layout_gravity="bottom|end"
                        android:background="@drawable/background_icon_edit" android:src="@drawable/ic_edit_profile" />
                </FrameLayout>
                <EditText android:id="@+id/vprof_editor_profile_name" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="@dimen/_10sdp" android:background="@android:color/transparent"
                    android:ems="10" android:hint="@string/unnamed" android:inputType="textPersonName"
                    android:textColor="#FFFFFF" android:textColorHint="#6B6B78" android:textSize="@dimen/_14ssp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" android:layout_marginBottom="@dimen/_3sdp"
                android:text="@string/profiles_profile_version" android:textColor="#8EE07F" android:textSize="11sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/vprof_editor_version_spinner" android:layout_width="0dp" android:layout_height="@dimen/_32sdp"
                    android:layout_weight="1" android:layout_marginEnd="@dimen/_6sdp"
                    android:background="@drawable/nick_card_bg" android:gravity="center_vertical"
                    android:hint="@string/version_select_hint" android:maxLines="1" android:ellipsize="end"
                    android:paddingHorizontal="@dimen/_10sdp" android:textColor="#FFFFFF" android:textColorHint="#6B6B78"
                    android:textSize="@dimen/_12ssp" />
                <com.kdt.mcgui.MineButton android:id="@+id/vprof_editor_version_button" android:layout_width="wrap_content"
                    android:layout_height="@dimen/_32sdp" android:minWidth="@dimen/_56sdp" android:paddingHorizontal="@dimen/_10sdp"
                    android:text="@string/global_select" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" android:layout_marginBottom="@dimen/_3sdp"
                android:text="@string/default_control" android:textColor="#8EE07F" android:textSize="11sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/vprof_editor_ctrl_spinner" android:layout_width="0dp" android:layout_height="@dimen/_32sdp"
                    android:layout_weight="1" android:layout_marginEnd="@dimen/_6sdp"
                    android:background="@drawable/nick_card_bg" android:gravity="center_vertical"
                    android:hint="@string/use_global_default" android:maxLines="1" android:ellipsize="end"
                    android:paddingHorizontal="@dimen/_10sdp" android:textColor="#FFFFFF" android:textColorHint="#6B6B78"
                    android:textSize="@dimen/_12ssp" />
                <com.kdt.mcgui.MineButton android:id="@+id/vprof_editor_ctrl_button" android:layout_width="wrap_content"
                    android:layout_height="@dimen/_32sdp" android:minWidth="@dimen/_56sdp" android:paddingHorizontal="@dimen/_10sdp"
                    android:text="@string/global_select" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" android:layout_marginBottom="@dimen/_3sdp"
                android:text="Game folder" android:textColor="#8EE07F" android:textSize="11sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/vprof_editor_path" android:layout_width="0dp" android:layout_height="@dimen/_32sdp"
                    android:layout_weight="1" android:layout_marginEnd="@dimen/_6sdp"
                    android:background="@drawable/nick_card_bg" android:gravity="center_vertical"
                    android:hint=".minecraft" android:maxLines="1" android:ellipsize="end"
                    android:paddingHorizontal="@dimen/_10sdp" android:textColor="#FFFFFF" android:textColorHint="#6B6B78"
                    android:textSize="@dimen/_12ssp" />
                <com.kdt.mcgui.MineButton android:id="@+id/vprof_editor_path_button" android:layout_width="wrap_content"
                    android:layout_height="@dimen/_32sdp" android:minWidth="@dimen/_56sdp" android:paddingHorizontal="@dimen/_10sdp"
                    android:text="@string/global_select" />
            </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="@dimen/_6sdp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PERFORMANCE" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <View android:layout_width="@dimen/_30sdp" android:layout_height="2dp"
                android:layout_marginTop="3dp" android:background="#5EC84F" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" android:layout_marginBottom="@dimen/_3sdp"
                android:text="@string/pedit_java_runtime" android:textColor="#8EE07F" android:textSize="11sp" android:textStyle="bold" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Spinner android:id="@+id/vprof_editor_spinner_runtime" android:layout_width="match_parent" android:layout_height="@dimen/_32sdp"
                    android:background="@drawable/nick_card_bg" android:paddingStart="@dimen/_10sdp" android:paddingEnd="@dimen/_26sdp" />
                <ImageView android:layout_width="wrap_content" android:layout_height="@dimen/_8sdp"
                    android:layout_gravity="end|center_vertical" android:paddingHorizontal="@dimen/_8sdp"
                    android:importantForAccessibility="no" android:rotation="180" android:src="@drawable/spinner_arrow" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" android:layout_marginBottom="@dimen/_3sdp"
                android:text="@string/pedit_renderer" android:textColor="#8EE07F" android:textSize="11sp" android:textStyle="bold" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Spinner android:id="@+id/vprof_editor_profile_renderer" android:layout_width="match_parent" android:layout_height="@dimen/_32sdp"
                    android:background="@drawable/nick_card_bg" android:paddingStart="@dimen/_10sdp" android:paddingEnd="@dimen/_26sdp" android:dropDownWidth="match_parent" />
                <ImageView android:layout_width="wrap_content" android:layout_height="@dimen/_8sdp"
                    android:layout_gravity="end|center_vertical" android:paddingHorizontal="@dimen/_8sdp"
                    android:importantForAccessibility="no" android:rotation="180" android:src="@drawable/spinner_arrow" />
            </FrameLayout>
            <CheckBox android:id="@+id/vprof_editor_profile_angle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp" android:buttonTint="#5EC84F" android:text="@string/use_angle_checkbox" android:textColor="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" android:layout_marginBottom="@dimen/_3sdp"
                android:text="@string/pvc_jvmArgs" android:textColor="#8EE07F" android:textSize="11sp" android:textStyle="bold" />
            <EditText android:id="@+id/vprof_editor_jre_args" android:layout_width="match_parent" android:layout_height="@dimen/_32sdp"
                android:background="@drawable/nick_card_bg" android:ems="10" android:hint="@string/use_global_default" android:inputType="text"
                android:paddingHorizontal="@dimen/_10sdp" android:textColor="#FFFFFF" android:textColorHint="#6B6B78" android:textSize="@dimen/_12ssp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_10sdp" android:layout_marginVertical="@dimen/_6sdp">
        <com.kdt.mcgui.MineButton android:id="@+id/vprof_editor_save_button" android:layout_width="0dp"
            android:layout_height="@dimen/_36sdp" android:layout_weight="1" android:layout_marginEnd="@dimen/_6sdp" android:text="@string/global_save" />
        <com.kdt.mcgui.MineButton android:id="@+id/vprof_editor_delete_button" android:layout_width="0dp"
            android:layout_height="@dimen/_36sdp" android:layout_weight="1" android:layout_marginStart="@dimen/_6sdp" android:text="@string/global_delete" />
    </LinearLayout>
</LinearLayout>
